<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.example.fullness.stationary.repository.ProductRepository">

    <resultMap id="ProductResult" type="com.example.fullness.stationary.entity.Product">
        <id property="id" column="id" />
        <result property="name" column="name" />
        <result property="price" column="price" />
        <result property="imageUrl" column="image_url" />
        <result property="productCategoryId" column="product_category_id" />
        <result property="deleteFlag" column="delete_flag" />
    </resultMap>    
    <select id="findAllWithPaging" resultMap="ProductResult">
        SELECT id, name, price, image_url, product_category_id, delete_flag
        FROM product
        ORDER BY id ASC
        LIMIT #{limit} OFFSET #{offset}
    </select>   
    <select id="findByCategoryIdWithPaging" resultMap="ProductResult">
        SELECT id, name, price, image_url, product_category_id, delete_flag
        FROM product
        WHERE product_category_id = #{categoryId}
        ORDER BY id ASC
        LIMIT #{limit} OFFSET #{offset}
    </select>   
    <select id="countAll" resultType="long">
        SELECT COUNT(*) FROM product
    </select>   
    <select id="countByCategoryId" resultType="long">
        SELECT COUNT(*) FROM product WHERE product_category_id = #{categoryId}
    </select>   
    <!-- ▼ ProjectCategory を ProductCategory に修正済み -->
    <select id="findAllCategories" resultType="com.example.fullness.stationary.entity.ProductCategory">
        SELECT id, name
        FROM product_category
        ORDER BY id ASC
    </select>

    <!--↓↓↓ここからUC12↓↓↓-->

    <!-- 1. 商品名から商品情報を検索するSQL（重複チェック用） -->
    <!-- 削除されていない(delete_flag = 0)商品から同名のものを検索します -->
    <select id="findByName" resultMap="ProductResult">
        SELECT id, name, price, image_url, product_category_id, delete_flag
        FROM product
        WHERE name = #{name} AND delete_flag = 0
    </select>

    <!-- 2. 商品情報を更新（修正）するSQL -->
    <!-- 指定された商品ID(id)のデータに対して、新しい商品名と価格を上書き保存します -->
    <update id="updateProduct">
        UPDATE product
        SET name = #{name},
            price = #{price}
        WHERE id = #{id}
    </update>

</mapper>
