<?xml version="1.0" encoding="UTF-8"?> 
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.example.fullness.stationary.repository.EmployeeAccountRepository">

    <!-- 【UC17 担当者ログイン用】アカウント単体（パスワード照合用）のマッピング -->
    <resultMap id="EmployeeAccountResult" type="com.example.fullness.stationary.entity.EmployeeAccount">
        <id property="id" column="id" /> 
        <result property="employeeId" column="employee_id" /> 
        <result property="name" column="name" /> 
        <result property="password" column="password"/>
        <result property="failedAttempts" column="failed_attempts"/>
        <result property="lockTime" column="lock_time"/>
    </resultMap>

    <!-- 【UC17 担当者ログイン】アカウント名からパスワード照合のために1件取得する -->
    <select id="findByName" resultMap="EmployeeAccountResult"> 
        SELECT 
            id,
            employee_id,
            name,
            password,
            failed_attempts,
            lock_time
        FROM employee_account
        WHERE name = #{name} 
    </select>

    <!-- ログイン失敗回数とロック日時の更新用SQL -->
    <update id="updateLockStatus" parameterType="com.example.fullness.stationary.entity.EmployeeAccount">
        UPDATE employee_account
        SET 
            failed_attempts = #{failedAttempts},
            lock_time = #{lockTime}
        WHERE 
            name = #{name}
    </update>
  <!-- ==================================================================== -->
    <!-- 🔽 UC09で追記しました 🔽 -->
    <!-- ==================================================================== -->

    <!-- 1. アカウント名の重複チェック用SQL -->
    <select id="countByName" resultType="int">
        SELECT COUNT(*)
        FROM employee_account
        WHERE name = #{name}
    </select>

    <!-- 2. 担当者アカウント新規登録用SQL -->
    <insert id="insertEmployeeAccount">
        INSERT INTO employee_account (
            employee_id,
            name,
            password,
            employee_account_role,
            failed_attempts,
            lock_time
        ) VALUES (
            #{employeeId},
            #{name},
            #{password},
            #{employeeAccountRole},
            #{failedAttempts},
            #{lockTime}
        )
    </insert>


    //UC09で追記しました
        <!-- 2. アカウント名の重複件数を数える -->
    <select id="countByName" resultType="int">
        SELECT COUNT(*) 
        FROM employee_account 
        WHERE name = #{name}
    </select>

    <!-- 3. 新規アカウントを登録する（INSERT） -->
    <insert id="insertEmployeeAccount">
        INSERT INTO employee_account (employee_id, name, password) 
        VALUES (#{employeeId}, #{name}, #{password})
    </insert>

</mapper>
