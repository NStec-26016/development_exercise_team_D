<?xml version="1.0" encoding="UTF-8"?> 
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.example.fullness.stationary.repository.EmployeeAccountRepository">

    <!-- 【UC17 担当者ログイン用】アカウント単体（パスワード照合用）のマッピング -->
    
        <id property="id" column="id" /> 
        <result property="employeeId" column="employee_id" /> 
        <result property="name" column="name" /> 
        <result property="password" column="password"/>
        <result property="failedAttempts" column="failed_attempts"/>
        <result property="lockTime" column="lock_time"/>
    </resultMap>

    <!-- 【UC17 担当者ログイン】アカウント名からパスワード照合のために1件取得する -->
    <select id="findByName" resultMap="EmployeeAccountResult"> 
        SELECT 
            id,
            employee_id,
            name,
            password,
            failed_attempts,
            lock_time
        FROM employee_account
        WHERE name = #{name} 
    </select>

    <!-- ログイン失敗回数とロック日時の更新用SQL -->
    
        UPDATE employee_account
        SET 
            failed_attempts = #{failedAttempts},
            lock_time = #{lockTime}
        WHERE 
            name = #{name}
    </update>


    <!-- ==================================================================== -->
    <!-- 🔽 ここから下が、アカウント登録（UC09）のために新しく「追記」したSQL 🔽 -->
    <!-- ==================================================================== -->

    <!-- 1. アカウント名の重複チェック用SQL -->
    <select id="countByName" resultType="int">
        SELECT COUNT(*)
        FROM employee_account
        WHERE name = #{name}
    </select>

    <!-- 2. 担当者アカウント新規登録用SQL -->
    <!-- XMLのマッピングにより、Javaオブジェクトのフィールド名（camelCase）が、DBのカラム名（snake_case）へ正しく変換されて挿入されます -->
    
        INSERT INTO employee_account (
            employee_id,
            name,
            password,
            failed_attempts,
            lock_time
        ) VALUES (
            #{employeeId},
            #{name},
            #{password},
            #{failedAttempts},
            #{lockTime}
        )
    </insert>

</mapper>
