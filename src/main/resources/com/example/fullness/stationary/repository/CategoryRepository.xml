<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.example.fullness.stationary.repository.CategoryRepository">

    <resultMap id="CategoryResult" type="com.example.fullness.stationary.entity.Category">
        <id property="id" column="id" />
        <result property="name" column="name" />
    </resultMap>

    <select id="findAllByOrderByCategoryIdAsc" resultMap="CategoryResult">
        SELECT id, name
        FROM product_category
        ORDER BY id ASC
    </select>

</mapper>