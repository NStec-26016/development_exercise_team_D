<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "mybatis-3-mapper.dtd">
<mapper namespace="com.example.fullness.stationary.repository.EmployeeRepository">

    <!-- Employeeエンティティへのマッピング定義 -->
    <resultMap id="EmployeeResultMap" type="com.example.fullness.stationary.entity.Employee">
        <id property="id" column="id" />
        <result property="departmentId" column="department_id" />
        <result property="name" column="name" />
        <result property="nameKana" column="name_kana" />
        <result property="password" column="password" />
    </resultMap>

    <!-- 1. アカウントテーブルに存在しない社員を社員ID順に取得 -->
    <select id="findUnregisteredEmployees" resultMap="EmployeeResultMap">
        SELECT e.id, e.department_id, e.name, e.name_kana
        FROM employee e
        LEFT JOIN employee_account a ON e.id = a.employee_id
        WHERE a.employee_id IS NULL
        ORDER BY e.id ASC
    </select>

</mapper>

