<?xml version="1.0" encoding="UTF-8"?> 
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.example.fullness.stationary.repository.ProductRepository">

 

<insert id="insertProduct" parameterType="com.example.fullness.stationary.entity.Product">
    INSERT INTO product (
            product_category_id,
            name,
            price,
            image_url,
            delete_flag
        ) VALUES (
            #{product_category_id},
            #{name},
            #{price},
            #{image_url},
            0
        )
    </insert>

</mapper>

<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.example.fullness.stationary.repository.ProductRepository">

    <resultMap id="ProductResult" type="com.example.fullness.stationary.entity.Product">
        <id property="id" column="id" />
        <result property="name" column="name" />
        <result property="price" column="price" />
        <result property="imagePath" column="image_url" />
        <result property="categoryId" column="product_category_id" />
    </resultMap>

    <select id="findAllWithPaging" resultMap="ProductResult">
        SELECT id, name, price, image_url, product_category_id
        FROM product
        ORDER BY id ASC
        LIMIT #{limit} OFFSET #{offset}
    </select>

    <select id="findByCategoryIdWithPaging" resultMap="ProductResult">
        SELECT id, name, price, image_url, product_category_id
        FROM product
        WHERE product_category_id = #{categoryId}
        ORDER BY id ASC
        LIMIT #{limit} OFFSET #{offset}
    </select>

    <select id="countAll" resultType="long">
        SELECT COUNT(*) FROM product
    </select>

    <select id="countByCategoryId" resultType="long">
        SELECT COUNT(*) FROM product WHERE product_category_id = #{categoryId}
    </select>

</mapper>
