<?xml version="1.0" encoding="UTF-8"?> 
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.example.fullness.stationary.repository.ProductRepository">

 

<insert id="insertProduct" parameterType="com.example.fullness.stationary.entity.Product">
    INSERT INTO product (
            product_category_id,
            name,
            price,
            image_url,
            delete_flag
        ) VALUES (
            #{product_category_id},
            #{name},
            #{price},
            #{image_url},
            0
        )
    </insert>

</mapper>

